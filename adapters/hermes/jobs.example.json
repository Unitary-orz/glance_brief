{
  "version": 1,
  "runtime": "hermes",
  "template": true,
  "jobs": [
    {
      "name": "agents-report daily",
      "schedule_utc": "0 2 * * *",
      "script": "skills/agents-report/scripts/agents_radar_prefetch.py",
      "prompt_file": "skills/agents-report/prompts/agents-report-v2.md",
      "model": "<model>",
      "deliver": "<platform>:<chat_id>"
    },
    {
      "name": "noon-news",
      "schedule_utc": "30 4 * * *",
      "script": "skills/noon-news/scripts/noon_news_prefetch.py",
      "prompt_file": "skills/noon-news/prompts/news-brief-v2.md",
      "model": "<model>",
      "deliver": "<platform>:<chat_id>"
    }
  ]
}
