{
  "version": 2,
  "runtime": "hermes-preview",
  "template": true,
  "mode": "agent-handoff-preview",
  "note": "Run install/install.py install --runtime hermes-preview first. Each script is relative to $HERMES_HOME/scripts/. The installer prints the self-contained prompt and required environment variables; create jobs through Hermes' native scheduler interface. Do not enable these jobs while the corresponding formal/legacy writer is still enabled for the same destination.",
  "jobs": [
    {
      "name": "agents-report V2 preview",
      "schedule_utc": "5 2 * * *",
      "script": "glance-brief-v2/agents-v2.py",
      "no_agent": false,
      "prompt_source": "glance-brief-v2/cron-prompts/agents-handoff.md",
      "required_environment": [
        "GLANCE_BRIEF_PREVIEW_CONFIG",
        "GLANCE_BRIEF_PREVIEW_PREFETCH",
        "GLANCE_BRIEF_PREVIEW_PUBLICATION_DIR",
        "GLANCE_BRIEF_PREVIEW_MODEL",
        "GLANCE_BRIEF_PREVIEW_PROVIDER",
        "GLANCE_BRIEF_PREVIEW_REASONING"
      ],
      "deliver": "<platform>:<chat_id>"
    },
    {
      "name": "noon-news V2 preview",
      "schedule_utc": "35 4 * * *",
      "script": "glance-brief-v2/noon-v2.py",
      "no_agent": false,
      "prompt_source": "glance-brief-v2/cron-prompts/noon-handoff.md",
      "required_environment": [
        "GLANCE_BRIEF_PREVIEW_CONFIG",
        "GLANCE_BRIEF_PREVIEW_PREFETCH",
        "GLANCE_BRIEF_PREVIEW_MODEL",
        "GLANCE_BRIEF_PREVIEW_PROVIDER",
        "GLANCE_BRIEF_PREVIEW_REASONING"
      ],
      "deliver": "<platform>:<chat_id>"
    }
  ]
}
