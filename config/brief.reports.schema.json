{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Unitary-orz/glance_brief/blob/main/config/brief.reports.schema.json",
  "title": "glance_brief reports configuration",
  "description": "Editor-facing schema for reports schema_version 3. Runtime validation in glance_brief.adapters remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "reports"],
  "properties": {
    "schema_version": {"const": 3},
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "reports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/report"}
    }
  },
  "$defs": {
    "pathSpec": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "map"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "driver": {
          "type": "string",
          "enum": ["json_file", "command_json", "snapshot_json"]
        },
        "path": {"type": "string", "minLength": 1},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"type": "string", "minLength": 1},
        "items_path": {"$ref": "#/$defs/pathSpec"},
        "channel_id": {"type": "string", "minLength": 1},
        "channel_label": {"type": "string", "minLength": 1},
        "timeout": {"type": "number", "exclusiveMinimum": 0},
        "required": {"type": "boolean"},
        "env_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "^[^=]+$"}
        },
        "exclude": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "map": {"$ref": "#/$defs/map"},
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fresh_hot": {"$ref": "#/$defs/pathSpec"},
            "local_report_categories": {"$ref": "#/$defs/pathSpec"},
            "quality": {"$ref": "#/$defs/pathSpec"},
            "markdown": {"$ref": "#/$defs/pathSpec"},
            "new_projects": {"$ref": "#/$defs/pathSpec"},
            "publication": {"$ref": "#/$defs/pathSpec"}
          }
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"$ref": "#/$defs/pathSpec"},
        "text": {"$ref": "#/$defs/pathSpec"},
        "published_at": {"$ref": "#/$defs/pathSpec"},
        "strip_urls_from_text": {"type": "boolean"},
        "extra": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/pathSpec"}
        },
        "links": {
          "type": "array",
          "items": {"$ref": "#/$defs/link"}
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "label_path": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["label"]},
        {"required": ["label_path"]}
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "match": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {}
          }
        },
        "take": {"type": "integer", "minimum": 1}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_candidates"],
      "properties": {
        "minimum_candidates": {"type": "integer", "minimum": 0}
      }
    },
    "selectionLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 0},
        "max": {"type": "integer", "minimum": 0}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "kind", "editorial_hint", "bindings", "health", "policy"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "order": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["editorial_items", "semantic_clusters", "producer_markdown", "semantic_synthesis", "project_board"]
        },
        "editorial_hint": {"type": "string", "minLength": 1},
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/binding"}
        },
        "health": {"$ref": "#/$defs/health"},
        "policy": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["selection_limit"],
              "properties": {"selection_limit": {"$ref": "#/$defs/selectionLimit"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["max_items", "max_candidates_per_item", "coverage_target"],
              "properties": {
                "max_items": {"type": "integer", "minimum": 1},
                "max_candidates_per_item": {"type": "integer", "minimum": 1, "maximum": 3},
                "coverage_target": {"type": "integer", "minimum": 0}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshot_key"],
              "properties": {"snapshot_key": {"type": "string", "minLength": 1}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["exact_items"],
              "properties": {"exact_items": {"type": "integer", "minimum": 1}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["fresh_snapshot_key", "categories_snapshot_key", "quality_snapshot_key", "max_projects_per_category", "fresh_title"],
              "properties": {
                "fresh_snapshot_key": {"type": "string", "minLength": 1},
                "categories_snapshot_key": {"type": "string", "minLength": 1},
                "quality_snapshot_key": {"type": "string", "minLength": 1},
                "max_projects_per_category": {"type": "integer", "minimum": 1},
                "fresh_title": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_type", "title", "input", "features", "components"],
      "properties": {
        "profile_type": {"type": "string", "enum": ["news_digest", "ecosystem_digest"]},
        "title": {"type": "string", "minLength": 1},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "path"],
          "properties": {
            "driver": {"const": "json_file"},
            "path": {"type": "string", "minLength": 1}
          }
        },
        "features": {"type": "object"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    }
  }
}
