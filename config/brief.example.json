{
  "schema_version": 2,
  "sources": {
    "news_wire": {
      "driver": "json_file",
      "path": "../tests/fixtures/pipeline/news.json",
      "items_path": "items",
      "channel_id": "news-summary",
      "channel_label": "NS",
      "required": true,
      "map": {
        "title": "title",
        "text": "summary",
        "published_at": "published_at",
        "extra": {
          "category": "category"
        },
        "links": [
          {
            "role": "article",
            "label_path": "source.name",
            "path": "links.canonical"
          }
        ]
      }
    },
    "ai_digest": {
      "driver": "json_file",
      "path": "../tests/fixtures/pipeline/ai.json",
      "items_path": "payload.entries",
      "channel_id": "aihot",
      "channel_label": "AIHOT",
      "map": {
        "title": "headline",
        "text": "abstract",
        "published_at": "published",
        "extra": {
          "category": "category"
        },
        "links": [
          {
            "role": "item",
            "label": "AIHOT",
            "path": "links.aihot"
          },
          {
            "role": "original",
            "label_path": "publisher.name",
            "path": "links.original"
          }
        ]
      }
    },
    "open_source_radar": {
      "driver": "json_file",
      "path": "../tests/fixtures/pipeline/open-source.json",
      "items_path": "signals.hot_today",
      "channel_id": "github",
      "channel_label": "GitHub",
      "map": {
        "title": "full_name",
        "text": "description",
        "extra": {
          "full_name": "full_name",
          "description": "description",
          "stars_today": "stars_today",
          "is_fresh_hot": "is_fresh_hot",
          "language": "language",
          "topics": "topics"
        },
        "links": [
          {
            "role": "repository",
            "label_path": "full_name",
            "path": "url"
          }
        ]
      },
      "snapshot": {
        "fresh_hot": "signals.fresh_hot",
        "local_report_categories": "local_report_categories",
        "quality": "quality",
        "new_projects": "signals.new_projects"
      }
    },
    "codex_radar": {
      "driver": "json_file",
      "path": "../tests/fixtures/pipeline/codexradar.json",
      "items_path": "items",
      "channel_id": "codexradar",
      "channel_label": "CodexRadar",
      "map": {},
      "snapshot": {
        "markdown": "markdown"
      }
    }
  },
  "reports": {
    "noon-news": {
      "minimum_candidates": {
        "international": 1,
        "macro_business": 1,
        "ai": 1
      },
      "selection_limits": {
        "international": {"min": 1, "max": 6},
        "macro_business": {"min": 1, "max": 6},
        "ai": {"min": 1, "max": 6}
      },
      "sections": {
        "international": [
          {
            "source": "news_wire",
            "match": {
              "category": [
                "international"
              ]
            },
            "take": 8
          }
        ],
        "macro_business": [
          {
            "source": "news_wire",
            "match": {
              "category": [
                "business"
              ]
            },
            "take": 8
          }
        ],
        "ai": [
          {
            "source": "ai_digest",
            "take": 8
          }
        ]
      }
    },
    "agents-report": {
      "minimum_candidates": {
        "ai_ecosystem": 1,
        "codexradar": 0,
        "open_source": 1
      },
      "sections": {
        "ai_ecosystem": [
          {
            "source": "ai_digest",
            "take": 8
          }
        ],
        "codexradar": [],
        "open_source": [
          {
            "source": "open_source_radar",
            "take": 10
          }
        ]
      },
      "metadata": {
        "codexradar": {
          "source": "codex_radar"
        },
        "open_source": {
          "source": "open_source_radar"
        }
      }
    }
  }
}
