{
  "schema_version": 2,
  "project": "glance_brief",
  "project_version": "0.3.0",
  "python_deps": ["feedparser>=6.0,<7"],
  "core": {
    "source": "glance_brief",
    "destination": "lib/glance_brief",
    "entrypoint": "glance-brief.py",
    "config_template": "config/brief.example.json",
    "config_target": "brief.example.json",
    "runtime_config_target": "brief.json"
  },
  "external_skills": {
    "news-aggregator-skill": {
      "expected_script": "scripts/fetch_news.py",
      "source_hint": "Hermes skill (news-aggregator-skill); provide its install source when missing"
    },
    "news-summary": {
      "expected_script": "scripts/fetch_rss.py",
      "source_hint": "Hermes skill (news-summary); provide its install source when missing"
    }
  },
  "components": {
    "agents-report": {
      "description": "AI / Agents ecosystem daily report",
      "lib_source": "skills/agents-report/scripts",
      "prompt": "skills/agents-report/prompts/agents-report.md",
      "entrypoint": "agents-report.py",
      "default_schedule": "0 2 * * *",
      "config_templates": {
        "codexradar_watch.json": "skills/agents-report/config/codexradar_watch.example.json",
        "agents_radar_quality.json": "skills/agents-report/config/agents_radar_quality.example.json"
      }
    },
    "noon-news": {
      "description": "Midday news briefing",
      "lib_source": "skills/noon-news/scripts",
      "prompt": "skills/noon-news/prompts/news-brief.md",
      "entrypoint": "noon-news.py",
      "default_schedule": "30 4 * * *",
      "config_templates": {}
    }
  },
  "utility_entrypoints": {
    "agents-quality-check.py": {
      "lib_component": "agents-report",
      "module": "agents_radar_quality_check.py"
    },
    "codexradar.py": {
      "lib_component": "agents-report",
      "module": "codexradar_efficiency.py"
    }
  },
  "runtime_adapters": {
    "hermes": {
      "kind": "formal-batch",
      "config_schema_version": 2,
      "scripts_dir": "scripts/glance-brief",
      "data_dir": "data/glance-brief",
      "jobs_file": "cron/jobs.json"
    },
    "hermes-reports": {
      "kind": "agent-handoff",
      "config_schema_version": 3,
      "scripts_dir": "scripts/glance-brief-reports",
      "data_dir": "data/glance-brief-reports",
      "jobs_file": "cron/jobs.json"
    }
  },
  "reports_runtime": {
    "source_root": "runtime/reports",
    "lib_source": "runtime/reports/lib/glance_brief",
    "entrypoints": {
      "agents-report": {
        "source": "runtime/reports/entrypoints/agents.py",
        "installed": "entrypoints/agents.py",
        "cron_entrypoint": "agents.py",
        "environment": {
          "data": "GLANCE_BRIEF_AGENTS_DATA",
          "config": "GLANCE_BRIEF_AGENTS_CONFIG",
          "prefetch": "GLANCE_BRIEF_AGENTS_PREFETCH",
          "model": "GLANCE_BRIEF_AGENTS_MODEL",
          "provider": "GLANCE_BRIEF_AGENTS_PROVIDER",
          "reasoning": "GLANCE_BRIEF_AGENTS_REASONING",
          "publication_dir": "GLANCE_BRIEF_AGENTS_PUBLICATION_DIR"
        },
        "required_environment": [
          "GLANCE_BRIEF_AGENTS_PREFETCH",
          "GLANCE_BRIEF_AGENTS_PUBLICATION_DIR"
        ]
      },
      "noon-news": {
        "source": "runtime/reports/entrypoints/news.py",
        "installed": "entrypoints/news.py",
        "cron_entrypoint": "news.py",
        "environment": {
          "data": "GLANCE_BRIEF_NEWS_DATA",
          "config": "GLANCE_BRIEF_NEWS_CONFIG",
          "prefetch": "GLANCE_BRIEF_NEWS_PREFETCH",
          "model": "GLANCE_BRIEF_NEWS_MODEL",
          "provider": "GLANCE_BRIEF_NEWS_PROVIDER",
          "reasoning": "GLANCE_BRIEF_NEWS_REASONING"
        },
        "required_environment": [
          "GLANCE_BRIEF_NEWS_PREFETCH"
        ]
      }
    },
    "cron_prompts": {
      "agents-report": "runtime/reports/cron/agents-handoff.md",
      "noon-news": "runtime/reports/cron/noon-handoff.md"
    },
    "config_template": "config/brief.reports.example.json",
    "config_target": "brief.reports.example.json",
    "runtime_config_target": "brief-live.json",
    "offline_fixture": "tests/fixtures/pipeline/reports-snapshot.json",
    "test": "runtime/reports/tests/test_productization.py",
    "deployment_note": "Explicit source-command configuration is required for each report; install never edits Cron jobs or delivery settings"
  }
}
